{
  // Daily check-in sender for the web build (https://lunara-ecm.pages.dev).
  // Deploy from here: npx wrangler deploy
  // Secret (copy in .secrets/vapid-private.jwk.json, gitignored):
  //   npx wrangler secret put VAPID_PRIVATE_KEY < .secrets/vapid-private.jwk.json
  "name": "lunara-push",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  // Cron only: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "lunara-push", "database_id": "09e091a3-6047-4460-bc85-989b77158b29" }
  ],
  "vars": {
    // Same key as VAPID_PUBLIC_KEY in app/src/web/push.ts.
    "VAPID_PUBLIC_KEY": "BH7E9Eiandhl6KWLzuvADZDiu3AwNW1CnTrY_gu-bjJ6cUiKluV8O_fM9XqnW5U6GsPOEQ-yXYntuDhv2434Sek",
    // Contact push services see on every send (Apple requires mailto: or https:).
    "VAPID_SUBJECT": "https://lunara-ecm.pages.dev"
  }
}
